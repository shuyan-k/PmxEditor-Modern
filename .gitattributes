* text=auto

# 跨平台文本：源码与脚本统一 LF，Windows 脚本保留 CRLF
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.pmx binary
*.pmd binary
